# =============================================================================
# ApplyWise AI — Environment Variables
# Copy this file to .env.local and populate with your credentials.
# NEVER commit real credentials or .env.local to version control!
# =============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL + pgvector + Auth + Storage)
# Free Tier: https://supabase.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# OpenCode Zen AI Suite & Cloudflare AI Gateway (100% Free Tier)
# Strict Free Tier Governance: FREE_ONLY_MODE=true
# -----------------------------------------------------------------------------
FREE_ONLY_MODE=true
SIMULATION_REACHABLE_FROM_PRODUCTION=false
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key
OPENCODE_DEFAULT_REASONING_MODEL=nemotron-3-ultra-free
OPENCODE_FAST_MODEL=nemotron-3.5-lightning-free
OPENCODE_LONG_CONTEXT_MODEL=ling-3.0-flash-fin-free
OPENCODE_STRUCTURED_MODEL=mimo-v2.5-free
OPENCODE_CREATIVE_MODEL=muse-spark-1.3-contributor-free
CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/nwhite-systems/applywise-ai
CLOUDFLARE_AI_GATEWAY_ENABLED=true

# -----------------------------------------------------------------------------
# Job Discovery APIs (Free Tiers)
# Adzuna: https://developer.adzuna.com
# -----------------------------------------------------------------------------
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# -----------------------------------------------------------------------------
# Observability & Grafana Cloud Free Integration
# Free Tier: https://grafana.com/auth/sign-up/create-user
# -----------------------------------------------------------------------------
GRAFANA_CLOUD_PROMETHEUS_ENDPOINT=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=123456
GRAFANA_CLOUD_API_KEY=glc_your_grafana_cloud_metrics_publisher_token
GRAFANA_URL=https://your-org.grafana.net
GRAFANA_AUTH=glsa_your_service_account_token
