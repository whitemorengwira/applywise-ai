            "steps": [
              { "color": "green", "value": 150 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 0 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Pipeline Integrity & Resiliency",
      "type": "row"
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "type": "timeseries",
      "title": "Job Pipeline Velocity & Analysis Rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(applywise_jobs_analyzed_total[5m])) * 60",
