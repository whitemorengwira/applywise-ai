      "type": "stat",
      "title": "Target Quota Remaining (Rolling 7-Day)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "200 - (sum(applywise_applications_submitted_total) or vector(0))",
