{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "PostgreSQL & Vector Store Performance",
      "type": "row"
    },
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "type": "stat",
      "title": "DB Query Throughput",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(applywise_db_queries_total[5m])) * 60",
          "legendFormat": "Queries / Min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      }
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "type": "stat",
      "title": "p95 Query Latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(applywise_db_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 250 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "type": "stat",
      "title": "Database Error Rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(applywise_db_queries_total{status=\"error\"}[5m])) or vector(0)",
          "legendFormat": "Errors / s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "type": "timeseries",
      "title": "Query Volume by Table & Operation",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(applywise_db_queries_total[5m])) by (table_name, operation)",
          "legendFormat": "{{table_name}} ({{operation}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "type": "timeseries",
      "title": "Query Latency Distribution",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(applywise_db_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "Median (p50) ms",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(applywise_db_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 ms",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["applywise", "database", "supabase", "postgres"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "ApplyWise AI — Database & Storage Operations",
  "uid": "applywise-database-ops",
  "version": 1
}
